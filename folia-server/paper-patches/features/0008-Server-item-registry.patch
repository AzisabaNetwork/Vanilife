new file mode 100644
index 0000000000000000000000000000000000000000..6d95d4c11b964d3dc4e083f0c9747fe277d4d286
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/util/HeightAwareGeneratorAccess.java
@@ -0,0 +1,43 @@
+package org.bukkit.craftbukkit.util;
+
+import net.azisaba.vanilife.server.world.height.HeightContext;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.levelgen.Heightmap;
+
+public class HeightAwareGeneratorAccess extends TransformerLevelAccessor {
+    private final HeightContext heightContext;
+
+    public HeightAwareGeneratorAccess(HeightContext heightContext) {
+        this.heightContext = heightContext;
+    }
+
+    @Override
+    public BlockPos getHeightmapPos(Heightmap.Types heightmap, BlockPos pos) {
+        return super.getHeightmapPos(this.heightContext.map(heightmap), pos);
+    }
+
+    @Override
+    public int getHeight(Heightmap.Types heightmap, int x, int z) {
+        return super.getHeight(this.heightContext.map(heightmap), x, z);
+    }
+
+    @Override
+    public int getSeaLevel() {
+        return this.heightContext.y(this.heightContext.seaLevel());
+    }
+
+    @Override
+    public int getMinY() {
+        return this.heightContext.minY();
+    }
+
+    @Override
+    public int getHeight() {
+        return this.heightContext.maxY() - this.heightContext.minY() + 1;
+    }
+
+    @Override
+    public int getMaxY() {
+        return this.heightContext.maxY();
+    }
+}
