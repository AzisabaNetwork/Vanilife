                         .collect(Collectors.toUnmodifiableList());
                     RegistryOps.RegistryInfoLookup contextAndNewRegistries = createContext(contextRegistries, loadTasks);
+
+                    // Vanilife start - Register Vanilife objects in data-driven registries
+                    loadTasks.forEach(task -> {
+                        final WritableRegistry<?> registry = task.registry;
+
+                        if (registry.key().equals(Registries.BIOME)) {
+                            VanilifeBiomes.bootstrap((WritableRegistry<Biome>) registry, contextAndNewRegistries);
+                        } else if (registry.key().equals(Registries.CONFIGURED_FEATURE)) {
+                            VanilifeConfiguredFeatures.bootstrap((WritableRegistry<net.minecraft.world.level.levelgen.feature.ConfiguredFeature<?, ?>>) registry, contextAndNewRegistries);
+                        } else if (registry.key().equals(Registries.PLACED_FEATURE)) {
+                            VanilifePlacedFeatures.bootstrap((WritableRegistry<PlacedFeature>) registry, contextAndNewRegistries);
+                        } else if (registry.key().equals(Registries.DIMENSION_TYPE)) {
+                            VanilifeDimensionTypes.bootstrap((WritableRegistry<DimensionType>) registry, contextAndNewRegistries);
+                        } else if (registry.key().equals(Registries.LEVEL_STEM)) {
+                            VanilifeLevelStems.bootstrap((WritableRegistry<LevelStem>) registry, contextAndNewRegistries);
+                        }
+                    });
+                    // Vanilife end - Register Vanilife objects in data-driven registries
+
                     int taskCount = loadTasks.size();
                     CompletableFuture<?>[] loadCompletions = new CompletableFuture[taskCount];
 
